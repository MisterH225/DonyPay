// DonyPay — Prisma schema
// Models métier à ajouter progressivement (identity, catalog, etc.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserType {
  individual
  company
}

enum KycStatus {
  pending
  verified
  rejected
}

enum KycDocumentType {
  identity_document
  proof_of_address
}

enum TwoFactorMethod {
  totp
  sms
}

/// Rôle applicatif — `admin` réservé à la console ops (jamais exposé au mobile).
enum UserRole {
  user
  admin
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  phone            String?
  type             UserType
  role             UserRole         @default(user)
  firstName        String?          @map("first_name")
  lastName         String?          @map("last_name")
  companyName      String?          @map("company_name")
  siret            String?
  kycStatus        KycStatus        @default(pending) @map("kyc_status")
  kycReviewedAt    DateTime?        @map("kyc_reviewed_at") @db.Timestamptz(6)
  kycRejectReason  String?          @map("kyc_reject_reason")
  externalKycId    String?          @map("external_kyc_id")
  twoFactorEnabled Boolean          @default(false) @map("two_factor_enabled")
  twoFactorMethod  TwoFactorMethod? @map("two_factor_method")
  totpSecret       String?          @map("totp_secret")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  documents           KycDocument[]
  twoFactorChallenges TwoFactorChallenge[]
  shop                Shop?
  savingsGoals        SavingsGoal[]
  notifications       Notification[]
  disputesOpened      Dispute[]           @relation("DisputeOpenedBy")
  disputeMessages     DisputeMessage[]
  disputeAttachments  DisputeAttachment[]
  disputeRatings      DisputeRating[]

  @@index([kycStatus])
  @@index([role])
  @@map("users")
}

model KycDocument {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         KycDocumentType
  storageKey   String          @map("storage_key")
  originalName String          @map("original_name")
  mimeType     String          @map("mime_type")
  sizeBytes    Int             @map("size_bytes")
  uploadedAt   DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  @@index([userId, type])
  @@map("kyc_documents")
}

model TwoFactorChallenge {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     TwoFactorMethod
  codeHash   String?         @map("code_hash")
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?       @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("two_factor_challenges")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Boutique — un vendeur (User) possède au plus une boutique.
model Shop {
  id          String    @id @default(uuid())
  sellerId    String    @unique @map("seller_id")
  seller      User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@map("shops")
}

model Product {
  id           String        @id @default(uuid())
  shopId       String        @map("shop_id")
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal       @db.Decimal(18, 2)
  photoKey     String?       @map("photo_key")
  qrPayload    String        @map("qr_payload")
  qrCodeKey    String        @map("qr_code_key")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  savingsGoals SavingsGoal[]

  @@index([shopId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

enum LedgerEntryType {
  debit
  credit
}

enum LedgerAccountKind {
  savings
  clearing
}

/// Compte ledger (épargne utilisateur ou compte de compensation système).
model LedgerAccount {
  id                   String                  @id @default(uuid())
  userId               String?                 @map("user_id")
  kind                 LedgerAccountKind
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  entries              LedgerEntry[]
  mobileMoneyCollections MobileMoneyCollection[]

  @@index([userId])
  @@map("ledger_accounts")
}

/// Écritures append-only (jamais d'UPDATE / DELETE).
model LedgerEntry {
  id           String          @id @default(uuid())
  accountId    String          @map("account_id")
  account      LedgerAccount   @relation(fields: [accountId], references: [id])
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(18, 2)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(18, 2)
  metadata     Json?
  /// Ordre total monotone (auto-increment) — critère de tri fiable pour le solde.
  sequence     Int             @default(autoincrement())
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, createdAt])
  @@index([accountId, sequence])
  @@map("ledger_entries")
}

/// Collecte Mobile Money async (CinetPay) — initiation → USSD → webhook HMAC.
enum MobileMoneyCollectionStatus {
  pending
  ussd_sent
  confirmed
  failed
}

model MobileMoneyCollection {
  id            String                      @id @default(uuid())
  providerRef   String                      @unique @map("provider_ref")
  accountId     String                      @map("account_id")
  account       LedgerAccount               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount        Decimal                     @db.Decimal(18, 2)
  currency      String                      @default("XOF")
  phone         String
  operator      String?
  status        MobileMoneyCollectionStatus @default(pending)
  description   String?
  metadata      Json?
  ussdHint      String?                     @map("ussd_hint")
  failureReason String?                     @map("failure_reason")
  confirmedAt   DateTime?                   @map("confirmed_at") @db.Timestamptz(6)
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([accountId, status])
  @@index([status, createdAt])
  @@map("mobile_money_collections")
}

// ---------------------------------------------------------------------------
// Savings engine
// ---------------------------------------------------------------------------

enum SavingsMode {
  schedule
  flexi
}

enum SavingsGoalStatus {
  active
  ready_for_withdrawal
  completed
  cancelled
}

enum InstallmentStatus {
  pending
  paid
  overdue
  cancelled
}

/// Objectif d'épargne lié à un produit (montant cible = prix produit).
model SavingsGoal {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       String            @map("product_id")
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  mode            SavingsMode
  targetAmount    Decimal           @map("target_amount") @db.Decimal(18, 2)
  savedAmount     Decimal           @default(0) @map("saved_amount") @db.Decimal(18, 2)
  status          SavingsGoalStatus @default(active)
  ledgerAccountId String            @map("ledger_account_id")
  flexiStartsAt   DateTime?         @map("flexi_starts_at") @db.Timestamptz(6)
  flexiEndsAt     DateTime?         @map("flexi_ends_at") @db.Timestamptz(6)
  readyAt         DateTime?         @map("ready_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  installments SavingsInstallment[]
  deposits     SavingsDeposit[]
  disputes     Dispute[]

  @@index([userId, status])
  @@index([productId])
  @@map("savings_goals")
}

/// Échéance fixe (mode Échéancier) avec rappel.
model SavingsInstallment {
  id             String            @id @default(uuid())
  goalId         String            @map("goal_id")
  goal           SavingsGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sequence       Int
  dueDate        DateTime          @map("due_date") @db.Timestamptz(6)
  amount         Decimal           @db.Decimal(18, 2)
  status         InstallmentStatus @default(pending)
  reminderSentAt DateTime?         @map("reminder_sent_at") @db.Timestamptz(6)
  paidAt         DateTime?         @map("paid_at") @db.Timestamptz(6)
  payerName      String?           @map("payer_name")
  payerPhone     String?           @map("payer_phone")
  payerOperator  String?           @map("payer_operator")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  deposits     SavingsDeposit[]
  paymentLinks PaymentLink[]

  @@index([goalId, dueDate])
  @@index([status, dueDate])
  @@map("savings_installments")
}

model SavingsDeposit {
  id            String              @id @default(uuid())
  goalId        String              @map("goal_id")
  goal          SavingsGoal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  installmentId String?             @map("installment_id")
  installment   SavingsInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  amount        Decimal             @db.Decimal(18, 2)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([goalId, createdAt])
  @@map("savings_deposits")
}

// ---------------------------------------------------------------------------
// Payment links
// ---------------------------------------------------------------------------

enum PaymentLinkStatus {
  pending
  paid
  expired
  cancelled
}

/// Lien de paiement à usage unique pour une échéance précise.
model PaymentLink {
  id            String            @id @default(uuid())
  token         String            @unique
  installmentId String            @map("installment_id")
  installment   SavingsInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Decimal           @db.Decimal(18, 2)
  status        PaymentLinkStatus @default(pending)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?         @map("used_at") @db.Timestamptz(6)
  payerName     String?           @map("payer_name")
  payerPhone    String?           @map("payer_phone")
  payerOperator String?           @map("payer_operator")
  providerRef   String?           @map("provider_ref")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  disputes Dispute[]

  @@index([installmentId, status])
  @@index([expiresAt])
  @@map("payment_links")
}

// ---------------------------------------------------------------------------
// Disputes (réclamations)
// ---------------------------------------------------------------------------

/// Motif de réclamation.
enum DisputeReason {
  non_conforming_product
  payment_not_received
  third_party_payer
}

/// Cycle de vie d'un litige.
enum DisputeStatus {
  open
  in_progress
  resolved
  rejected
}

/// Cible de la réclamation : plan d'épargne ou paiement délégué.
enum DisputeSubjectType {
  savings_goal
  payment_link
}

model Dispute {
  id            String             @id @default(uuid())
  openedById    String             @map("opened_by_id")
  openedBy      User               @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  reason        DisputeReason
  status        DisputeStatus      @default(open)
  subjectType   DisputeSubjectType @map("subject_type")
  savingsGoalId String?            @map("savings_goal_id")
  savingsGoal   SavingsGoal?       @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  paymentLinkId String?            @map("payment_link_id")
  paymentLink   PaymentLink?       @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  title         String
  description   String
  resolutionNote String?           @map("resolution_note")
  resolvedAt    DateTime?          @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages    DisputeMessage[]
  attachments DisputeAttachment[]
  rating      DisputeRating?

  @@index([openedById, status])
  @@index([savingsGoalId])
  @@index([paymentLinkId])
  @@index([status, createdAt])
  @@map("disputes")
}

/// Historique d'échanges sur un litige.
model DisputeMessage {
  id        String   @id @default(uuid())
  disputeId String   @map("dispute_id")
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

/// Pièce jointe liée à un litige.
model DisputeAttachment {
  id           String   @id @default(uuid())
  disputeId    String   @map("dispute_id")
  dispute      Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([disputeId])
  @@map("dispute_attachments")
}

/// Notation utilisateur post-résolution (uniquement si status = resolved).
model DisputeRating {
  id        String   @id @default(uuid())
  disputeId String   @unique @map("dispute_id")
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("dispute_ratings")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  metadata  Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("notifications")
}
