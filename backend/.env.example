# Local Docker Compose Postgres
# Préférer un rôle applicatif sans UPDATE/DELETE sur ledger_entries (voir migration 20260803060000).
DATABASE_URL="postgresql://donypay:donypay@localhost:5432/donypay?schema=public"
# DATABASE_URL="postgresql://donypay_app:donypay@localhost:5432/donypay?schema=public"

# Supabase (production / remote)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.rqjaktnwmqzkwldywyjx.supabase.co:5432/postgres?schema=public"
SUPABASE_URL="https://rqjaktnwmqzkwldywyjx.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-publishable-key"

PORT=3000
NODE_ENV=development

# Stockage local des pièces KYC
KYC_UPLOAD_DIR="./uploads/kyc"

# Stockage local des pièces jointes litiges
DISPUTE_UPLOAD_DIR="./uploads/disputes"

# Catalog — photos / QR produits
CATALOG_UPLOAD_DIR="./uploads/catalog"
CATALOG_PUBLIC_BASE_URL="https://donypay.app/p"

# Payment links — TTL (heures) et URL publique
PAYMENT_LINK_TTL_HOURS=48
PAYMENT_LINK_PUBLIC_BASE_URL="http://localhost:3000/api/payment-links/public"

# Mobile Money / CinetPay (collecte LedgerPort — sandbox par défaut)
CINETPAY_SANDBOX=true
CINETPAY_API_KEY="sandbox_api_key"
CINETPAY_SITE_ID="sandbox_site"
CINETPAY_SECRET_KEY="cinetpay_sandbox_secret"
CINETPAY_NOTIFY_BASE_URL="http://localhost:3000/api/ledger-adapter/mobile-money"
