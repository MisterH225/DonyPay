# URL de l'API Nest (préfixe /api inclus)
DONYPAY_API_URL=http://localhost:3000/api

# Doit correspondre à ADMIN_API_KEY du backend
ADMIN_API_KEY=change-me-admin-key

# Mot de passe de connexion à la console (jamais exposé au client)
ADMIN_PASSWORD=change-me-admin-password

# Secret de signature du cookie de session admin
ADMIN_SESSION_SECRET=change-me-session-secret
