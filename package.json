{
  "name": "donypay",
  "private": true,
  "version": "0.1.0",
  "description": "DonyPay — Buy Now Pay Later monorepo",
  "workspaces": [
    "backend",
    "mobile",
    "admin"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:test": "npm run test --workspace=backend",
    "backend:start:prod": "npm run start:prod --workspace=backend",
    "mobile:start": "npm run start --workspace=mobile",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend",
    "ci": "npm run typecheck --workspace=backend && npm run test --workspace=backend && npm run backend:build && npm run typecheck --workspace=admin && npm run admin:build && npm run typecheck --workspace=mobile",
    "railway:build": "npm ci && npm run backend:build",
    "admin:dev": "npm run dev --workspace=admin",
    "admin:build": "npm run build --workspace=admin",
    "brand:assets": "node brand/generate-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
